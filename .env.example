# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL (Supabase pooler)
# Transaction pooler (runtime) + session pooler (migrations)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-32-byte-secret-value!!
TWO_FACTOR_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# PIN 2FA de démo (ignoré en production)
DEMO_2FA_PIN=123456

# Supabase Storage (S3-compatible)
S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_BUCKET=docushield
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Optional SMTP (falls back to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DocuShield AI <noreply@docushield.local>
